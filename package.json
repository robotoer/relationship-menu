  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "eject": "react-scripts eject",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "env-cmd chromatic",
    "verify": "while read -r f; do [ -n \"$f\" ] && lsc check --backend=dafny \"$f\"; done < LemmaScript-files.txt && dafny verify docs/spec/formal/dafny/MenuEditing.dfy"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@4.3.0",
  "resolutions": {
    "node-datachannel": "^0.29.0",
    "libp2p@npm:^1.3.0": "patch:libp2p@npm%3A1.8.1#~/.yarn/patches/libp2p-npm-1.8.1-391f2ba9d6.patch"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/addon-onboarding": "^10.6.9",
