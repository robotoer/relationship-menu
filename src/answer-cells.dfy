// Generated by lsc from answer-cells.ts

datatype Cell = absent | none | must_have | like_to_have | maybe | soft_no | off_limits

function isAnswered(c: Cell): bool
{
  ((!c.absent?) && (!c.none?))
}

function wants(c: Cell): bool
{
  (c.must_have? || c.like_to_have?)
}

function everyoneAnswered(cells: seq<Cell>): bool
{
  ((|cells| > 0) && Std.Collections.Seq.All(cells, (c: Cell) => isAnswered(c)))
}

function isConflict(cells: seq<Cell>): bool
{
  ((exists c :: c in cells && wants(c)) && (exists c :: c in cells && c.off_limits?))
}

function isAgree(cells: seq<Cell>): bool
{
  (everyoneAnswered(cells) && Std.Collections.Seq.All(cells, (c: Cell) => (c == cells[0])))
}

function isAllWant(cells: seq<Cell>): bool
{
  (everyoneAnswered(cells) && Std.Collections.Seq.All(cells, (c: Cell) => wants(c)))
}

function isDiffer(cells: seq<Cell>): bool
{
  ((everyoneAnswered(cells) && !(isAgree(cells))) && !(isConflict(cells)))
}

function isUnanswered(cells: seq<Cell>): bool
{
  (exists c :: c in cells && c.none?)
}

function isMissing(cells: seq<Cell>): bool
{
  (exists c :: c in cells && c.absent?)
}

function checkFullyAnsweredHasOneVerdict(cells: seq<Cell>): bool
  requires everyoneAnswered(cells)
{
  true
}

lemma checkFullyAnsweredHasOneVerdict_ensures(cells: seq<Cell>)
  requires everyoneAnswered(cells)
  ensures ((isAgree(cells) || isDiffer(cells)) || isConflict(cells))
  ensures !((isAgree(cells) && isConflict(cells)))
  ensures !((isAgree(cells) && isDiffer(cells)))
  ensures !((isDiffer(cells) && isConflict(cells)))
