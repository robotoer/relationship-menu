    "@types/pako": "^2.0.4",
    "@types/prop-types": "^15",
    "chromatic": "^11.29.0",
    "env-cmd": "^11.0.0",
    "eslint-plugin-storybook": "^10.6.9",
    "fast-check": "^3.23.2",
    "lemmascript": "0.6.12",
    "playwright": "^1.58.2",
    "prop-types": "^15.8.1",
    "storybook": "^10.6.9",
    "webpack": "^5.113.0"
  }
