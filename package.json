{
  "name": "relationship-menu",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Robert Chu <allegrormc@gmail.com>",
  "dependencies": {
    "@fontsource/press-start-2p": "^5",
    "@fontsource/vt323": "^5",
    "pako": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-random-avatars": "^1.3.1",
    "react-router-dom": "^7.18.7",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -p . && vite build",
    "start:handoff": "vite --config vite.handoff.config.mts",
    "build:handoff": "tsc -p . && vite build --config vite.handoff.config.mts",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "verify": "while read -r f; do [ -n \"$f\" ] && npx -y -p lemmascript@0.6.12 lsc check --backend=dafny \"$f\"; done < LemmaScript-files.txt && dafny verify docs/spec/formal/dafny/MenuEditing.dfy"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@4.3.0",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^22",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "type": "module"
}
